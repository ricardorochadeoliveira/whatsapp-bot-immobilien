# Claude API-Key fuer die Intent-Extraktion (Punkt 3).
# Nie committen - .env ist in .gitignore.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: anderes Claude-Modell verwenden
ANTHROPIC_MODEL=claude-sonnet-5

# Supabase-Postgres (Punkt 1). Zu finden in Supabase: Project Settings ->
# Database -> Connection string -> URI. Ist diese Variable NICHT gesetzt,
# laeuft die App mit In-Memory-Platzhalterdaten weiter.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Session-Pooler-Variante (falls kein IPv6 verfuegbar) - siehe README.
DATABASE_URL_RUNTIME=postgresql://app_runtime.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres

# Fuer Firmen-Login (Supabase Auth). Project Settings -> API.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Schuetzt das interne Admin-/Chat-Simulator-Panel. Selbst erzeugter Wert
# (z.B. via `python -c "import secrets; print(secrets.token_urlsafe(24))"`),
# kein externes Credential. Nicht gesetzt = kein Schutz (nur fuer lokale Dev).
ADMIN_API_KEY=

# Kostenschutz: begrenzt, wie oft pro Telefonnummer bzw. global pro Minute
# ein echter Claude-API-Aufruf ausgeloest werden darf (siehe
# app/rate_limiter.py). Defaults sind grosszuegig fuer normale Nutzung,
# aber verhindern, dass ein spammender Bot die Rechnung explodieren laesst.
RATE_LIMIT_PER_PHONE_PER_MINUTE=6
RATE_LIMIT_PER_PHONE_PER_DAY=200
RATE_LIMIT_GLOBAL_PER_MINUTE=60

# Meta WhatsApp Cloud API (direkt, kein BSP - siehe docs/produkt-abgleich.md).
# Alle vier Werte kommen aus dem Meta Developer Dashboard (developers.facebook.com):
# App -> WhatsApp -> API Setup (Access Token + Phone Number ID),
# App -> Einstellungen -> Grundlegendes (App-Geheimnis) fuer META_APP_SECRET.
# META_WEBHOOK_VERIFY_TOKEN: ein beliebiger, selbst gewaehlter String, den du
# beim Einrichten des Webhooks im Meta-Dashboard exakt gleich eintraegst.
# Ohne diese Variablen laeuft der simulierte Web-Chat weiter wie bisher.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# Superadmin-Bereich (/superadmin, siehe app/superadmin_auth.py). Kommagetrennte
# Liste erlaubter E-Mails - nur diese duerfen sich einloggen, auch wenn sie
# einen gueltigen Supabase-Auth-Account haben (siehe scripts/create_superadmin.py).
SUPERADMIN_EMAILS=

# Entwickler-Chat im Superadmin-Bereich (siehe app/code_assistant.py). Fine-
# grained GitHub Personal Access Token, NUR fuer dieses eine Repo, Berechtigung
# "Contents: Read and write". GITHUB_REPO/GITHUB_BRANCH sind optional (Defaults:
# dieses Repo, Branch master).
GITHUB_TOKEN=
GITHUB_REPO=ricardorochadeoliveira/whatsapp-bot-immobilien
GITHUB_BRANCH=master

# Railway-Werkzeuge im Entwickler-Chat (Deploy-Status/Logs pruefen, auf Bitte
# einen Redeploy anstossen - siehe app/railway_client.py). Account-API-Token
# aus den Railway-Account-Settings ("Tokens"). Projekt-/Service-/Environment-ID
# sind optional (Defaults zeigen bereits auf den WhatsApp-Bot-Service).
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_ENVIRONMENT_ID=
