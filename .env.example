# Claude API-Key fuer die Intent-Extraktion (Punkt 3).
# Nie committen - .env ist in .gitignore.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: anderes Claude-Modell verwenden
ANTHROPIC_MODEL=claude-sonnet-5

# Supabase-Postgres (Punkt 1). Zu finden in Supabase: Project Settings ->
# Database -> Connection string -> URI. Ist diese Variable NICHT gesetzt,
# laeuft die App mit In-Memory-Platzhalterdaten weiter.
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Session-Pooler-Variante (falls kein IPv6 verfuegbar) - siehe README.
DATABASE_URL_RUNTIME=postgresql://app_runtime.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:5432/postgres

# Fuer Firmen-Login (Supabase Auth). Project Settings -> API.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Schuetzt das interne Admin-/Chat-Simulator-Panel. Selbst erzeugter Wert
# (z.B. via `python -c "import secrets; print(secrets.token_urlsafe(24))"`),
# kein externes Credential. Nicht gesetzt = kein Schutz (nur fuer lokale Dev).
ADMIN_API_KEY=

# Kostenschutz: begrenzt, wie oft pro Telefonnummer bzw. global pro Minute
# ein echter Claude-API-Aufruf ausgeloest werden darf (siehe
# app/rate_limiter.py). Defaults sind grosszuegig fuer normale Nutzung,
# aber verhindern, dass ein spammender Bot die Rechnung explodieren laesst.
RATE_LIMIT_PER_PHONE_PER_MINUTE=6
RATE_LIMIT_PER_PHONE_PER_DAY=200
RATE_LIMIT_GLOBAL_PER_MINUTE=60
